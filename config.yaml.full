# 视频号采集助手完整配置
port: 2025
default_port: 2025
# 保留原数据目录，供采集数据库、评论及诊断数据使用。
data_dir: downloads
cert_file: SunnyRoot.cer
cert_install_delay: 3s
save_delay: 500ms

secret_token: ""
web_console_token: "@dongzuren"
allowed_origins: []

log_file: logs/wx_channel.log
max_log_size_mb: 5
save_page_snapshot: false
save_search_data: false
save_page_js: false
show_log_button: false
enable_log_interception: false

load_balancer_strategy: leastconn
compression_enabled: true
compression_threshold: 1024
# 雷达仅检测新作品并记录结果。
radar_enabled: false
